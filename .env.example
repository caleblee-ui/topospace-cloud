
# TopoSpace customer-facing API key
TOPOSPACE_API_KEY=replace-me
TOPOSPACE_TENANT_ID=default
TOPOSPACE_RPM=60
TOPOSPACE_MONTHLY_TOKEN_LIMIT=1000000
TOPOSPACE_MONTHLY_COST_LIMIT=100

# Primary OpenAI-compatible provider
PRIMARY_PROVIDER_BASE_URL=https://api.openai.com/v1
PRIMARY_PROVIDER_API_KEY=replace-provider-key
PRIMARY_PROVIDER_NAME=primary

# Optional fallback OpenAI-compatible provider
FALLBACK_PROVIDER_BASE_URL=
FALLBACK_PROVIDER_API_KEY=
FALLBACK_PROVIDER_NAME=fallback
PROVIDER_RETRIES=1

# Development only
ALLOW_MOCK_PROVIDER=false
